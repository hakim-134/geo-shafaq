# Copy to .env.local (gitignored). Only PUBLIC_ settings; they end up in the browser.
# Yandex Maps JS API key: https://developer.tech.yandex.ru/services, referrers: localhost, geo.shafaq.uz
PUBLIC_YANDEX_KEY=
# Mapillary client token (MLY|…): https://www.mapillary.com/dashboard/developers
PUBLIC_MAPILLARY_TOKEN=
# Where the API is; empty = api.geo.shafaq.uz on the site, the same host on :8131 anywhere else
PUBLIC_API_URL=
